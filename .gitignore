# Claude & Comet local runtime generated artifacts
.claude/skills/
.comet/*
.claude/hooks/guard-alerts.jsonl

# Machine-specific agent hook configurations (comet init / local IDE hooks with absolute paths)
.codex/hooks.json
.trae/hooks.json
.trae-cn/hooks.json
.devin/hooks.json
.github/hooks/
.kiro/hooks/

# Backup files generated during deployment
*.bak-*

# OS and system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary logs & scratch
*.log
scratch/
# Cost ledger telemetry (Phase 2, 2-3/2-5): one line per tool call, high-churn
# local telemetry — unlike gate/feature_list.json + events.jsonl (reviewable
# evidence, committed per D8), the ledger is never committed.
gate/cost-ledger.jsonl
# Skill-usage telemetry (D68): one line per Skill invocation, local only —
# same posture as the cost ledger; the ablation reads aggregates, and the
# raw file is never committed.
.claude/skill-usage.jsonl

# Local ai-memory project opt-in; never commit a machine/project marker by default
/.ai-memory.toml

# Python bytecode
__pycache__/
*.pyc
eval/cost-ledger.jsonl
# Gate & loop local runtime state (never committed)
gate/*-stop-state.json
gate/termination.json
loop-state.json
loop-events.jsonl
graph-state.jsonl
