{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node .workbuddy/hooks/workbuddy-post-tool-use.mjs",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node .workbuddy/hooks/workbuddy-pre-tool-use.mjs",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "node .workbuddy/hooks/workbuddy-pre-tool-use.mjs",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node .workbuddy/hooks/workbuddy-session-start.mjs",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node .workbuddy/hooks/workbuddy-stop.mjs",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
